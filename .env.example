# Local development defaults. Copy this file to .env; never commit secrets.
# Leave empty to derive the WebSocket URL from the current origin at /collaboration.
# For production, set wss://your-room-server before building.
NEXT_PUBLIC_COLLAB_URL=

# Optional standalone collaboration service (bun run collab:server).
# Normal bun dev / bun start integrates rooms on the app port.
COLLAB_HOST=127.0.0.1
COLLAB_PORT=3002
COLLAB_DATA_DIR=.collab-data

# Comma-separated allowed browser origins. Empty permits local development.
# Set to your HTTPS whiteboard origin when deploying.
COLLAB_ORIGINS=
