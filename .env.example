# Copy to .env. Empty URL means local same-origin collaboration.
NEXT_PUBLIC_COLLAB_URL=
# Optional canonical public URL for invite links.
NEXT_PUBLIC_APP_URL=

WEB_HOST=0.0.0.0
COLLAB_DATA_DIR=.collab-data
# Comma-separated exact browser origins; restrict this on deployed servers.
COLLAB_ORIGINS=

# Optional standalone room server only; bun dev/start integrates rooms automatically.
COLLAB_HOST=127.0.0.1
COLLAB_PORT=3002
