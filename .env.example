# Local defaults. Hosted deployment values are in .env.vercel.example and .env.render.example.
# bun dev / bun run start:local use local rooms regardless of hosted values in .env.
NEXT_PUBLIC_COLLAB_URL=
NEXT_PUBLIC_APP_URL=
WEB_HOST=0.0.0.0
COLLAB_DATA_DIR=.collab-data
COLLAB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Render/local Node server only. Paste the full pooled Neon URL, including its password.
DATABASE_URL=

# Public STUN is enabled; TURN remains optional and needs a working relay.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
CLASSROOM_MAX_PARTICIPANTS=8

# Optional standalone room server; integrated bun dev/start does not need these.
COLLAB_HOST=127.0.0.1
COLLAB_PORT=3002

# Accounts on the Next.js server. Local dev uses .auth-data/ unless DATABASE_URL is set.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AUTH_DATA_DIR=.auth-data
# Hosted auth requires DATABASE_URL + HTTPS BETTER_AUTH_URL + a random 32+ character secret.
# Run bun run auth:migrate before deployment. See docs/auth.md.
