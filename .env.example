# Hosted deployment defaults. Never commit real credentials.
NEXT_PUBLIC_COLLAB_URL=wss://excalidraw-tl7h.onrender.com/collaboration
NEXT_PUBLIC_APP_URL=https://knotleaf-desk.vercel.app
WEB_HOST=0.0.0.0
COLLAB_DATA_DIR=.collab-data
COLLAB_ORIGINS=https://knotleaf-desk.vercel.app,https://excalidraw-tl7h.onrender.com,http://localhost:3000,http://127.0.0.1:3000

# Render/local Node server only. Paste the full pooled Neon URL, including its password.
DATABASE_URL=

# Public STUN is enabled; TURN remains optional and needs a working relay.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
CLASSROOM_MAX_PARTICIPANTS=8

# Optional standalone room server; integrated bun dev/start does not need these.
COLLAB_HOST=127.0.0.1
COLLAB_PORT=3002
