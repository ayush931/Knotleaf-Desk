DATABASE_URL=
COLLAB_ORIGINS=https://knotleaf-desk.vercel.app,https://excalidraw-tl7h.onrender.com
CLASSROOM_MAX_PARTICIPANTS=8
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
