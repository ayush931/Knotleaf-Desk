{
  "name": "whiteboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server/web.mjs --dev",
    "build": "next build",
    "start": "node server/web.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "desktop:dev": "electron desktop/main.cjs --dev",
    "desktop:prepare": "bun run build && node scripts/prepare-desktop.mjs",
    "desktop:start": "electron desktop/main.cjs",
    "desktop:pack": "bun run desktop:prepare && electron-builder --dir",
    "desktop:build": "bun run desktop:prepare && electron-builder --publish never",
    "collab:server": "node server/collaboration.mjs"
  },
  "dependencies": {
    "@y/websocket-server": "0.1.0",
    "lucide-react": "^0.554.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "An open-source, local-first whiteboard and Markdown notebook for web and desktop.",
  "license": "MIT",
  "author": "Whiteboard contributors",
  "main": "desktop/main.cjs",
  "trustedDependencies": [
    "electron"
  ]
}
