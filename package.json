{
  "name": "whiteboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server/web.mjs --dev",
    "build": "next build",
    "start": "node server/web.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "collab:server": "node server/collaboration.mjs",
    "test:server": "node scripts/smoke-server.mjs",
    "build:server": "bun run build && node scripts/prepare-server.mjs"
  },
  "dependencies": {
    "@y/websocket-server": "0.1.0",
    "lucide-react": "^0.554.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "An open-source, local-first whiteboard and Markdown notebook for the web.",
  "license": "MIT",
  "author": "Whiteboard contributors",
  "homepage": "https://github.com/ayush931/excalidraw"
}
